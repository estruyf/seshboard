---
/** The Changelog page, built from the repository's CHANGELOG.md at build time. */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import source from '../../../CHANGELOG.md?raw';
import { renderChangelog } from '../lib/changelog.ts';
import NewFeatures from '../components/NewFeatures.astro';

const { html, headings } = renderChangelog(source);
// Only the releases in the table of contents; their New, Changed and Fixed would make it very long.
const toc = [{ depth: 2, slug: 'new-lately', text: 'New lately' }, ...headings.filter((heading) => heading.depth === 2)];
---

<StarlightPage
  frontmatter={{
    title: 'Changelog',
    description: 'What changed in each Seshboard release.',
    tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
  }}
  headings={toc}
>
  <p>
    Every release, newest first. <em>Unreleased</em> is what is coming in the next one. You can also see each release, with its <code>.dmg</code>, on the <a href="https://github.com/estruyf/switchboard/releases">releases page</a>.
  </p>
  <h2 id="new-lately">New lately</h2>
  <p>The biggest features of the last few releases, each with its page.</p>
  <NewFeatures />
  <Fragment set:html={html} />
</StarlightPage>
