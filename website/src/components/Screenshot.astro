---
/**
 * A screenshot of the app in the site's theme: `<name>-dark.png` and `<name>-light.png` from
 * src/assets/screenshots (taken by `npm run website:screenshots`), optimised by Astro. The build fails
 * when either is missing, so a page never points at a screenshot that doesn't exist.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  caption?: string;
  /** How wide it shows at most, in px (a dialog or a panel needs less room than the whole window). */
  width?: number;
  /** The first image on a page: load it straight away. */
  eager?: boolean;
}

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
const { name, alt, caption, width = 1440, eager = false } = Astro.props;
const pick = (scheme: 'dark' | 'light') => {
  const shot = shots[`../assets/screenshots/${name}-${scheme}.png`];
  if (!shot) throw new Error(`<Screenshot>: src/assets/screenshots/${name}-${scheme}.png is missing; run npm run website:screenshots`);
  return shot.default;
};
const dark = pick('dark');
const light = pick('light');
const sizes = `(min-width: 72rem) ${Math.min(width, 900)}px, 100vw`;
const widths = [480, 900, 1440, 1800].filter((w) => w <= dark.width);
const loading = eager ? 'eager' : 'lazy';
---

<figure class="sb-shot not-content" style={`max-width: ${width}px`}>
  <div class="sb-shot-frame">
    <Image src={dark} alt={alt} class="sb-shot-dark" widths={widths} sizes={sizes} loading={loading} />
    <Image src={light} alt={alt} class="sb-shot-light" widths={widths} sizes={sizes} loading={loading} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .sb-shot {
    margin: 1.5rem 0;
  }
  /* The app's window: rounded like a card, the overlay border so it stands out on either theme. */
  .sb-shot-frame {
    overflow: hidden;
    border: 1px solid var(--sb-overlay-border);
    border-radius: var(--sb-radius-card);
    background: var(--sb-bg);
  }
  .sb-shot-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sb-text-ui);
    color: var(--sb-muted);
  }
</style>
