---
/**
 * The homepage hero: the logo, the README's tagline, Download and Read the docs, and the main window
 * underneath in the site's theme. Only the splash page has a `hero`.
 */
import { Image } from 'astro:assets';
import logo from '../../assets/logo.svg';
import Screenshot from '../Screenshot.astro';

const { data } = Astro.locals.starlightRoute.entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = data.hero?.title ?? data.title;
const tagline = data.hero?.tagline;
---

<div class="sb-hero not-content">
  <Image src={logo} alt="" width={88} height={88} loading="eager" class="sb-hero-logo" />
  <h1 id="_top" data-page-title>{title}</h1>
  {tagline && <p class="sb-hero-tagline">{tagline}</p>}
  <div class="sb-hero-actions">
    <a class="sb-button primary" href="https://github.com/estruyf/switchboard/releases/latest">Download for Mac</a>
    <a class="sb-button secondary" href={`${base}/getting-started/install/`}>Read the docs</a>
  </div>
  <p class="sb-hero-note">For Macs with Apple Silicon. Needs Claude Code, signed in.</p>
  <div class="sb-hero-shot">
    <Screenshot
      name="main-window"
      eager
      alt="Switchboard with a finished session open: the session list on the left with sessions that need you and are working, the conversation in the middle and its git changes on the right"
    />
  </div>
</div>

<style>
  .sb-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: 3rem 1rem;
  }
  .sb-hero :global(.sb-hero-logo) {
    width: 88px;
    height: 88px;
    margin-bottom: 1rem;
  }
  h1 {
    margin: 0;
    font-size: calc(var(--sb-text-hero) * 2);
    font-weight: 600;
    line-height: 1.15;
    color: var(--sb-text);
  }
  .sb-hero-tagline {
    max-width: 34ch;
    margin: 0.75rem 0 0;
    font-size: var(--sb-text-hero);
    line-height: 1.4;
    color: var(--sb-muted);
  }
  .sb-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .sb-hero-note {
    margin: 0.75rem 0 0;
    font-size: var(--sb-text-meta);
    color: var(--sb-faint);
  }
  .sb-hero-shot {
    width: 100%;
    max-width: 1200px;
    margin-top: 2rem;
  }
</style>
