---
/**
 * The homepage hero: what's new, the headline, Download (for the reader's platform) and All features, the
 * Homebrew line, and the live board (LiveBoard.astro) underneath. Only the splash page has a `hero`.
 */
import { newPages } from '../../lib/docsPages.ts';
import LiveBoard from '../LiveBoard.astro';
import CopyCommand from '../CopyCommand.astro';

const { data } = Astro.locals.starlightRoute.entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = data.hero?.title ?? data.title;
const tagline = data.hero?.tagline;
const fresh = (await newPages()).slice(0, 3);
const releases = 'https://github.com/estruyf/switchboard/releases/latest';
---

<div class="sb-hero not-content">
  <div class="sb-hero-glow" aria-hidden="true"></div>
  {
    fresh.length > 0 && (
      <a class="sb-hero-news" href={`${base}/changelog/`}>
        <span class="sb-new">New</span>
        <span>{fresh.map((page) => page.title).join(', ')}</span>
        <span aria-hidden="true">→</span>
      </a>
    )
  }
  <h1 id="_top" data-page-title>{title}</h1>
  {tagline && <p class="sb-hero-tagline">{tagline}</p>}
  <div class="sb-hero-actions">
    <a class="sb-button primary large sb-os-mac" href={releases}>Download for Mac</a>
    <a class="sb-button primary large sb-os-windows" href={releases}>Download for Windows</a>
    <a class="sb-button secondary large" href={`${base}/features/`}>See all features</a>
  </div>
  <div class="sb-hero-install">
    <span class="sb-os-mac"><CopyCommand command="brew install --cask estruyf/tap/seshboard" /></span>
  </div>
  <p class="sb-hero-note">
    <span class="sb-os-mac">For Macs with Apple Silicon, macOS 13 or later.</span><span class="sb-os-windows">For Windows 10 and 11, on x64 and Arm64 PCs.</span>{' '}
    Free and open source. Needs Claude Code, signed in.
  </p>
  <div class="sb-hero-board">
    <LiveBoard />
  </div>
</div>

<style>
  .sb-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: 2.75rem 1rem;
  }
  /* A soft yellow light behind the headline, like the tour video's. */
  .sb-hero-glow {
    position: absolute;
    top: -4rem;
    left: 50%;
    width: min(64rem, 120vw);
    height: 30rem;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--sb-accent) 14%, transparent), transparent 62%);
    pointer-events: none;
  }
  .sb-hero > :not(.sb-hero-glow) {
    position: relative;
  }
  .sb-hero-news {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    padding: 0.3rem 0.85rem 0.3rem 0.35rem;
    border: 1px solid var(--sb-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sb-card) 70%, transparent);
    font-size: var(--sb-text-meta);
    color: var(--sb-muted);
    text-decoration: none;
  }
  .sb-hero-news > span:nth-child(2) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .sb-hero-news:hover {
    border-color: var(--sb-overlay-border);
    color: var(--sb-text);
  }
  h1 {
    max-width: 18ch;
    margin: 1.4rem 0 0;
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--sb-text);
    text-wrap: balance;
  }
  .sb-hero-tagline {
    max-width: 40rem;
    margin: 1.25rem 0 0;
    font-size: calc(var(--sb-text-body) * 1.15);
    line-height: 1.55;
    color: var(--sb-muted);
    text-wrap: pretty;
  }
  .sb-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .sb-hero-install {
    max-width: 100%;
    margin-top: 1rem;
  }
  .sb-hero-note {
    margin: 0.85rem 0 0;
    font-size: var(--sb-text-meta);
    color: var(--sb-faint);
  }
  .sb-hero-board {
    width: 100%;
    margin-top: 2.5rem;
  }
  @media (max-width: 30rem) {
    .sb-hero {
      padding-top: 1.5rem;
    }
    h1 {
      margin-top: 1.1rem;
    }
    .sb-hero-tagline {
      margin-top: 1rem;
      font-size: var(--sb-text-body);
    }
    .sb-hero-actions {
      width: 100%;
      margin-top: 1.5rem;
    }
    .sb-hero-board {
      margin-top: 1.75rem;
    }
    /* Nobody installs a Mac app from a phone: the command only costs room there. */
    .sb-hero-install {
      display: none;
    }
  }
</style>
