---
/** Starlight's footer (edit link, pagination), then a short row of links on every page. */
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { label: 'GitHub', href: 'https://github.com/estruyf/switchboard' },
  { label: 'Releases', href: 'https://github.com/estruyf/switchboard/releases' },
  { label: 'Changelog', href: `${base}/changelog/` },
  { label: 'MIT License', href: 'https://github.com/estruyf/switchboard/blob/main/LICENSE' },
];
const splash = Astro.locals.starlightRoute.entry.data.template === 'splash';
---

{!splash && <Default />}
<nav class="sb-footer not-content" aria-label="Switchboard links">
  <span class="sb-footer-name">Switchboard</span>
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
</nav>

<style>
  .sb-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sb-border);
    font-size: var(--sb-text-ui);
  }
  .sb-footer-name {
    margin-inline-end: auto;
    font-weight: 600;
    color: var(--sb-text);
  }
  .sb-footer a {
    color: var(--sb-muted);
    text-decoration: none;
  }
  .sb-footer a:hover {
    color: var(--sb-text);
  }
</style>
