---
/** Starlight's footer (edit link, pagination), then a short row of links on every page. */
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { label: 'GitHub', href: 'https://github.com/estruyf/switchboard' },
  { label: 'Releases', href: 'https://github.com/estruyf/switchboard/releases' },
  { label: 'Changelog', href: `${base}/changelog/` },
  { label: 'MIT License', href: 'https://github.com/estruyf/switchboard/blob/main/LICENSE' },
];
const splash = Astro.locals.starlightRoute.entry.data.template === 'splash';
/** The README's visitorbadge.io badge, with a slug per page: `website` for the homepage, `website/sessions/sidebar` for the others. */
const pageId = Astro.locals.starlightRoute.id.replace(/^\/|\/$/g, '');
const badgeQuery = new URLSearchParams({
  path: 'https://github.com/estruyf/switchboard',
  slug: pageId ? `website/${pageId}` : 'website',
});
const badge = {
  href: `https://visitorbadge.io/status?${badgeQuery}`,
  src: `https://api.visitorbadge.io/api/visitors?${badgeQuery}&labelColor=%2315181f&countColor=%23ffd43b`,
};
---

{!splash && <Default />}
<nav class="sb-footer not-content" aria-label="Seshboard links">
  <span class="sb-footer-name">Seshboard</span>
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
  <a class="sb-footer-badge" href={badge.href}><img src={badge.src} alt="Visitors" height="20" /></a>
</nav>

<style>
  .sb-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sb-border);
    font-size: var(--sb-text-ui);
  }
  .sb-footer-name {
    margin-inline-end: auto;
    font-weight: 600;
    color: var(--sb-text);
  }
  .sb-footer a {
    color: var(--sb-muted);
    text-decoration: none;
  }
  .sb-footer a:hover {
    color: var(--sb-text);
  }
  .sb-footer-badge {
    display: inline-flex;
  }
  .sb-footer-badge img {
    display: block;
    height: 20px;
  }
</style>
