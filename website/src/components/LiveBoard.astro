---
/**
 * The homepage's moving picture: a small, scripted Seshboard window, laid out as the app is: the title bar across the
 * top, the rail at the left edge with Sessions picked, the sessions in the panel beside it, and the session with its rail
 * of tools at the right edge. Sessions of Claude Code, GitHub Copilot and
 * Codex go from Working to Needs you and back, a permission gets allowed, a queued prompt turns ready and starts,
 * and a finished session gets its catch-up, in the app's status colours. The session's ticket sits in a browser
 * beside the conversation, and the pull request opens there when Claude is done. Behind the window, patch cables carry a pulse in the colour of each
 * event (the switchboard the app is named after). It is drawn in HTML, not a video, so it follows the site's
 * theme; it only runs while it is on screen, and with reduced motion it shows one still moment.
 */
const projects = {
  payments: { name: 'payments-api', tone: 'blue', icon: 'card' },
  store: { name: 'acme-store', tone: 'yellow', icon: 'bag' },
  docs: { name: 'docs-site', tone: 'purple', icon: 'page' },
} as const;
type ProjectKey = keyof typeof projects;
/** The agent's mark on each row: simple glyphs in the agents' colours, not their logos. */
const agents = {
  claude: 'Claude Code',
  copilot: 'GitHub Copilot',
  codex: 'Codex',
} as const;
type AgentKey = keyof typeof agents;

interface Row {
  id: string;
  title: string;
  project: ProjectKey;
  agent: AgentKey;
  group: 'needs' | 'working' | 'queue' | 'today';
  state: 'working' | 'needs' | 'waiting' | 'idle' | 'unread' | 'ready' | 'open';
  sub: string;
  age: string;
}

/** The sessions at the start of the loop; the script moves them around and puts them back. */
const rows: Row[] = [
  { id: 'stripe', title: 'Upgrade Stripe SDK to v18', project: 'payments', agent: 'claude', group: 'working', state: 'working', sub: 'chore/stripe-18 · payments-api', age: 'now' },
  { id: 'rounding', title: 'Fix rounding in invoice totals', project: 'payments', agent: 'copilot', group: 'working', state: 'working', sub: 'fix/invoice-rounding · payments-api', age: 'now' },
  { id: 'dark', title: 'Add dark mode toggle to settings', project: 'store', agent: 'codex', group: 'working', state: 'working', sub: 'feat/dark-mode · acme-store', age: '4m' },
  { id: 'search', title: 'Add product search with filters', project: 'store', agent: 'claude', group: 'queue', state: 'waiting', sub: 'Waits for acme-store to be free', age: '' },
  { id: 'auth', title: 'Refactor auth middleware', project: 'store', agent: 'copilot', group: 'today', state: 'idle', sub: 'main · acme-store', age: '1h' },
  { id: 'guide', title: 'Write a getting started guide', project: 'docs', agent: 'codex', group: 'today', state: 'idle', sub: 'main · docs-site', age: '4h' },
];
const groups = [
  { id: 'needs', label: 'Needs you', tone: 'needs' },
  { id: 'working', label: 'Working', tone: 'working' },
  { id: 'queue', label: 'Queue', tone: 'plain' },
  { id: 'today', label: 'Today', tone: 'plain' },
] as const;
/** The patch cords, from beyond the page's edge into a jack on the window's side (window x 448 to 1568, y in px). */
const jacks = [
  { id: 'l1', side: 'left', y: 150 },
  { id: 'l2', side: 'left', y: 300 },
  { id: 'l3', side: 'left', y: 440 },
  { id: 'r1', side: 'right', y: 190 },
  { id: 'r2', side: 'right', y: 340 },
  { id: 'r3', side: 'right', y: 470 },
] as const;
const cords = [
  { jack: 'l1', d: 'M0 40 C 220 40, 280 150, 442 150' },
  { jack: 'l2', d: 'M0 330 C 200 330, 270 300, 442 300' },
  { jack: 'l3', d: 'M60 604 C 160 470, 300 440, 442 440' },
  { jack: 'r1', d: 'M2016 70 C 1796 70, 1736 190, 1574 190' },
  { jack: 'r2', d: 'M2016 380 C 1816 380, 1746 340, 1574 340' },
  { jack: 'r3', d: 'M1956 604 C 1856 490, 1716 470, 1574 470' },
];
const initial = JSON.stringify(rows.map(({ id, group, state, sub, age }) => ({ id, group, state, sub, age })));
---

