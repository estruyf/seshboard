---
/**
 * The homepage's moving picture: a small, scripted Switchboard window. Sessions go from Working to Needs you and
 * back, a permission gets allowed, a queued prompt turns ready and starts, and a finished session gets its
 * catch-up, in the app's status colours. Behind the window, patch cables carry a pulse in the colour of each
 * event (the switchboard the app is named after). It is drawn in HTML, not a video, so it follows the site's
 * theme; it only runs while it is on screen, and with reduced motion it shows one still moment.
 */
const projects = {
  payments: { name: 'payments-api', tone: 'blue', icon: 'card' },
  store: { name: 'acme-store', tone: 'yellow', icon: 'bag' },
  docs: { name: 'docs-site', tone: 'purple', icon: 'page' },
} as const;
type ProjectKey = keyof typeof projects;

interface Row {
  id: string;
  title: string;
  project: ProjectKey;
  group: 'needs' | 'working' | 'queue' | 'today';
  state: 'working' | 'needs' | 'waiting' | 'idle' | 'unread' | 'ready' | 'open';
  sub: string;
  age: string;
}

/** The sessions at the start of the loop; the script moves them around and puts them back. */
const rows: Row[] = [
  { id: 'stripe', title: 'Upgrade Stripe SDK to v18', project: 'payments', group: 'working', state: 'working', sub: 'chore/stripe-18 · payments-api', age: 'now' },
  { id: 'rounding', title: 'Fix rounding in invoice totals', project: 'payments', group: 'working', state: 'working', sub: 'fix/invoice-rounding · payments-api', age: 'now' },
  { id: 'dark', title: 'Add dark mode toggle to settings', project: 'store', group: 'working', state: 'working', sub: 'feat/dark-mode · acme-store', age: '4m' },
  { id: 'search', title: 'Add product search with filters', project: 'store', group: 'queue', state: 'waiting', sub: 'Waits for acme-store to be free', age: '' },
  { id: 'auth', title: 'Refactor auth middleware', project: 'store', group: 'today', state: 'idle', sub: 'main · acme-store', age: '1h' },
  { id: 'guide', title: 'Write a getting started guide', project: 'docs', group: 'today', state: 'idle', sub: 'main · docs-site', age: '4h' },
];
const groups = [
  { id: 'needs', label: 'Needs you', tone: 'needs' },
  { id: 'working', label: 'Working', tone: 'working' },
  { id: 'queue', label: 'Queue', tone: 'plain' },
  { id: 'today', label: 'Today', tone: 'plain' },
] as const;
/** The patch cords, from beyond the page's edge into a jack on the window's side (window x 448 to 1568, y in px). */
const jacks = [
  { id: 'l1', side: 'left', y: 150 },
  { id: 'l2', side: 'left', y: 300 },
  { id: 'l3', side: 'left', y: 440 },
  { id: 'r1', side: 'right', y: 190 },
  { id: 'r2', side: 'right', y: 340 },
  { id: 'r3', side: 'right', y: 470 },
] as const;
const cords = [
  { jack: 'l1', d: 'M0 40 C 220 40, 280 150, 442 150' },
  { jack: 'l2', d: 'M0 330 C 200 330, 270 300, 442 300' },
  { jack: 'l3', d: 'M60 564 C 160 470, 300 440, 442 440' },
  { jack: 'r1', d: 'M2016 70 C 1796 70, 1736 190, 1574 190' },
  { jack: 'r2', d: 'M2016 380 C 1816 380, 1746 340, 1574 340' },
  { jack: 'r3', d: 'M1956 564 C 1856 490, 1716 470, 1574 470' },
];
const initial = JSON.stringify(rows.map(({ id, group, state, sub, age }) => ({ id, group, state, sub, age })));
---

<div
  class="lb not-content"
  data-live-board
  data-initial={initial}
  role="img"
  aria-label="A Switchboard window in motion: a session asks for permission and is allowed, another finishes, a queued prompt starts, and a finished session shows its catch-up with Commit."
>
  <svg class="lb-cables" viewBox="0 0 2016 564" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id="lb-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
    {/* The window spans 448 to 1568 here; each cord ends at a jack on its edge. */}
    <g class="lb-cords">
      {cords.map((cord) => <path d={cord.d} data-jack={cord.jack} vector-effect="non-scaling-stroke" />)}
    </g>
    <g class="lb-pulses" filter="url(#lb-glow)"></g>
  </svg>
  {jacks.map((jack) => <span class="lb-jack" data-jack={jack.id} style={`top: ${jack.y}px; ${jack.side}: -6px`} />)}

  <div class="lb-window" aria-hidden="true">
    <aside class="lb-side">
      <div class="lb-titlebar">
        <span class="lb-lights"><i></i><i></i><i></i></span>
        <span class="lb-appname">Switchboard</span>
      </div>
      <div class="lb-tools">
        <span class="lb-search">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          Search sessions
        </span>
        <span class="lb-iconbtn"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1Z" /></svg></span>
        <span class="lb-iconbtn lb-plus"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg></span>
      </div>
      <div class="lb-list">
        {
          groups.map((group) => (
            <section class="lb-group" data-group={group.id}>
              <div class:list={['lb-head', `tone-${group.tone}`]}>
                <span>{group.label}</span>
                <span class="lb-count" data-count>
                  0
                </span>
                {group.id === 'queue' && <span class="lb-head-note" data-queue-note />}
              </div>
              <div class="lb-rows">
                {rows
                  .filter((row) => row.group === group.id)
                  .map((row) => (
                    <div class="lb-row" data-row={row.id} data-state={row.state} data-selected={row.id === 'stripe' ? '' : undefined}>
                      <span class="lb-rail" />
                      <span class:list={['lb-picon', `tone-${projects[row.project].tone}`]}>
                        {projects[row.project].icon === 'card' && (
                          <svg viewBox="0 0 24 24">
                            <rect width="18" height="13" x="3" y="5.5" rx="2" />
                            <path d="M3 10h18" />
                          </svg>
                        )}
                        {projects[row.project].icon === 'bag' && (
                          <svg viewBox="0 0 24 24">
                            <path d="M6 3 4 6.5V20a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6.5L18 3Z" />
                            <path d="M4 6.5h16M15.5 10a3.5 3.5 0 0 1-7 0" />
                          </svg>
                        )}
                        {projects[row.project].icon === 'page' && (
                          <svg viewBox="0 0 24 24">
                            <path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8Z" />
                            <path d="M14 3v5h5M9 13h6M9 17h6" />
                          </svg>
                        )}
                      </span>
                      <span class="lb-text">
                        <span class="lb-title">{row.title}</span>
                        <span class="lb-sub" data-sub>
                          {row.sub}
                        </span>
                      </span>
                      <span class="lb-meta">
                        <span class="lb-age" data-age>
                          {row.age}
                        </span>
                        <span class="lb-status" />
                      </span>
                      <span class="lb-start" data-start>
                        <svg viewBox="0 0 24 24">
                          <path d="M7 4.5v15l12-7.5Z" />
                        </svg>
                        Start
                      </span>
                    </div>
                  ))}
              </div>
            </section>
          ))
        }
      </div>
      <div class="lb-foot">
        <span class="lb-focus"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /></svg><span data-focus>3 / 3</span></span>
        <span>6 sessions</span>
      </div>
    </aside>

    <main class="lb-main" data-main-state="working">
      <header class="lb-header">
        <span class="lb-picon tone-blue">
          <svg viewBox="0 0 24 24"><rect width="18" height="13" x="3" y="5.5" rx="2" /><path d="M3 10h18" /></svg>
        </span>
        <span class="lb-header-text">
          <span class="lb-header-title">Upgrade Stripe SDK to v18</span>
          <span class="lb-header-status"><span class="lb-dot"></span><span data-status>Claude is working</span> · payments-api · chore/stripe-18</span>
        </span>
        <span class="lb-header-actions">
          <span class="lb-seg"><span>Changes</span><span>Terminal</span></span>
        </span>
      </header>

      <div class="lb-convo">
        <div class="lb-prompt">Upgrade the Stripe SDK to v18 and fix whatever breaks. Run the tests when you're done.</div>
        <div class="lb-step" data-step="1"><span class="lb-step-dot"></span>Read 6 files and searched the code <em>8s</em></div>
        <p class="lb-reply" data-step="2">The breaking changes are in how charges are created and in the webhook types. I'll update both, then install v18 and run the tests.</p>
        <div class="lb-step" data-step="2"><span class="lb-step-dot"></span>Edited <code>src/billing/charge.ts</code> and 2 more files <em>21s</em></div>
        <div class="lb-perm" data-perm>
          <div class="lb-perm-title"><span class="lb-dot pulse"></span>Claude wants to run a command</div>
          <code class="lb-perm-cmd">npm install stripe@18 &amp;&amp; npm test</code>
          <div class="lb-perm-actions">
            <span class="lb-btn">Deny</span>
            <span class="lb-btn">Always allow</span>
            <span class="lb-btn primary" data-allow>Allow</span>
          </div>
        </div>
        <div class="lb-step lb-allowed" data-allowed><span class="lb-step-dot ok"></span>Allowed <code>npm install stripe@18</code></div>
        <div class="lb-step" data-step="3"><span class="lb-step-dot"></span>Ran the tests: 14 passed <em>34s</em></div>
        <div class="lb-thinking" data-thinking><i></i><i></i><i></i></div>
      </div>

      <div class="lb-catchup" data-catchup>
        <div class="lb-catchup-top">
          <span class="lb-dot unread"></span>
          <span class="lb-catchup-state">Finished</span>
          <span class="lb-catchup-title">Upgrade Stripe SDK to v18</span>
          <span class="lb-catchup-time">~2 min to review</span>
        </div>
        <div class="lb-catchup-need">Commit the changes</div>
        <div class="lb-catchup-text">Moved 3 calls to the v18 API and updated the webhook types. Every change stays in src/billing.</div>
        <div class="lb-catchup-row">
          <span class="lb-chip ok">14 tests passed</span>
          <span class="lb-chip">+57 −12 · 4 files</span>
          <span class="lb-chip ok">Followed the plan</span>
          <span class="lb-catchup-actions">
            <span class="lb-btn">Details</span>
            <span class="lb-btn primary" data-commit>Commit</span>
          </span>
        </div>
      </div>

      <div class="lb-composer">
        <span>Message Claude</span>
        <span class="lb-composer-chips"><span>Opus</span><span>High</span><span>Accept edits</span></span>
      </div>
    </main>

    <div class="lb-toast" data-toast>
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} alt="" width="28" height="28" />
      <span>
        <span class="lb-toast-app">Switchboard</span>
        <span class="lb-toast-title">Claude wants to use Bash</span>
        <span class="lb-toast-text">Upgrade Stripe SDK to v18</span>
      </span>
    </div>

    <svg class="lb-cursor" data-cursor viewBox="0 0 24 24"><path d="M5 3v16.5l4.6-4.4 3 6.4 2.8-1.3-3-6.3H19Z" /></svg>
  </div>
</div>

<script>
  type State = 'working' | 'needs' | 'waiting' | 'idle' | 'unread' | 'ready' | 'open';
  type Group = 'needs' | 'working' | 'queue' | 'today';
  interface RowStart {
    id: string;
    group: Group;
    state: State;
    sub: string;
    age: string;
  }

  /** The cable colour for each kind of event, the app's status colours. */
  const PULSE: Record<string, string> = { working: 'var(--sb-accent-ink)', needs: 'var(--sb-warn)', unread: 'var(--sb-unread)', ok: 'var(--sb-ok)' };

  function board(root: HTMLElement) {
    const win = root.querySelector<HTMLElement>('.lb-window')!;
    const list = root.querySelector<HTMLElement>('.lb-list')!;
    const main = root.querySelector<HTMLElement>('.lb-main')!;
    const cursor = root.querySelector<SVGElement>('[data-cursor]')!;
    const toast = root.querySelector<HTMLElement>('[data-toast]')!;
    const pulses = root.querySelector<SVGGElement>('.lb-pulses')!;
    const cords = [...root.querySelectorAll<SVGPathElement>('.lb-cords path')];
    const start: RowStart[] = JSON.parse(root.dataset.initial!);
    const row = (id: string) => root.querySelector<HTMLElement>(`[data-row="${id}"]`)!;
    const group = (id: Group) => root.querySelector<HTMLElement>(`[data-group="${id}"] .lb-rows`)!;

    let visible = false;
    let running = false;

    /** Waits `ms` of time on screen: the loop holds while the board is scrolled away or the tab is hidden. */
    async function wait(ms: number) {
      let left = ms;
      while (left > 0) {
        const step = Math.min(left, 100);
        await new Promise((resolve) => setTimeout(resolve, step));
        if (visible && !document.hidden) left -= step;
      }
    }

    /** Group counts and empty groups, as the app's sidebar shows them. */
    function tally() {
      root.querySelectorAll<HTMLElement>('.lb-group').forEach((section) => {
        const count = section.querySelectorAll('.lb-row').length;
        section.querySelector('[data-count]')!.textContent = String(count);
        section.hidden = count === 0;
      });
      const ready = root.querySelectorAll('[data-group="queue"] .lb-row[data-state="ready"]').length;
      const note = root.querySelector('[data-queue-note]');
      if (note) note.textContent = ready ? `${ready} ready` : '';
      const focus = root.querySelectorAll('.lb-row:is([data-state="working"], [data-state="needs"], [data-state="unread"])').length;
      root.querySelector('[data-focus]')!.textContent = `${Math.min(focus, 3)} / 3`;
    }

    /** Moves rows to where `change` puts them, sliding each from its old place (FLIP). */
    function move(change: () => void) {
      const items = [...list.querySelectorAll<HTMLElement>('.lb-row, .lb-head')];
      const before = new Map(items.map((el) => [el, el.getBoundingClientRect()]));
      change();
      tally();
      for (const el of items) {
        const was = before.get(el)!;
        const now = el.getBoundingClientRect();
        if (!now.height) continue;
        if (!was.height) {
          el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 320, easing: 'ease-out' });
          continue;
        }
        const dx = was.left - now.left;
        const dy = was.top - now.top;
        if (dx || dy) el.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], { duration: 520, easing: 'cubic-bezier(.2,.8,.2,1)' });
      }
    }

    function set(id: string, state: State, where?: Group, sub?: string, age?: string, first = false) {
      const el = row(id);
      move(() => {
        el.dataset.state = state;
        if (sub !== undefined) el.querySelector('[data-sub]')!.textContent = sub;
        if (age !== undefined) el.querySelector('[data-age]')!.textContent = age;
        if (where) {
          const target = group(where);
          if (first) target.prepend(el);
          else target.append(el);
        }
      });
      el.animate([{ backgroundColor: 'color-mix(in srgb, var(--sb-text) 9%, transparent)' }, { backgroundColor: 'transparent' }], { duration: 900 });
    }

    /** A pulse of light along a random cable, in the colour of what just happened; its jack lights up when it lands. */
    function pulse(kind: keyof typeof PULSE) {
      if (!cords.length || !cords[0]!.getBoundingClientRect().width) return;
      const cord = cords[Math.floor(Math.random() * cords.length)]!;
      const length = cord.getTotalLength();
      const dash = 140;
      const glow = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      glow.setAttribute('d', cord.getAttribute('d')!);
      glow.setAttribute('vector-effect', 'non-scaling-stroke');
      glow.style.stroke = PULSE[kind]!;
      glow.style.strokeDasharray = `${dash} ${length + dash}`;
      glow.style.strokeDashoffset = String(dash);
      pulses.append(glow);
      const jack = root.querySelector<HTMLElement>(`.lb-jack[data-jack="${cord.dataset.jack}"]`);
      glow
        .animate([{ strokeDashoffset: dash }, { strokeDashoffset: -length }], { duration: 1400 + Math.random() * 600, easing: 'cubic-bezier(.5,0,.3,1)' })
        .finished.then(
          () => {
            glow.remove();
            jack?.animate(
              [
                { borderColor: PULSE[kind], boxShadow: `0 0 0 4px color-mix(in srgb, ${PULSE[kind]} 30%, transparent), 0 0 14px ${PULSE[kind]}` },
                { borderColor: 'var(--sb-overlay-border)', boxShadow: 'none' },
              ],
              { duration: 900, easing: 'ease-out' },
            );
          },
          () => glow.remove(),
        );
    }

    /** Glides the pointer onto `target` and clicks it. */
    async function click(target: HTMLElement) {
      if (!target.offsetParent) return;
      const box = win.getBoundingClientRect();
      const at = target.getBoundingClientRect();
      cursor.style.opacity = '1';
      cursor.style.transform = `translate(${at.left - box.left + at.width * 0.5}px, ${at.top - box.top + at.height * 0.45}px)`;
      await wait(950);
      cursor.animate([{ scale: 1 }, { scale: 0.82 }, { scale: 1 }], { duration: 220, transformOrigin: 'top left' } as KeyframeAnimationOptions);
      target.animate([{ filter: 'brightness(1)' }, { filter: 'brightness(0.82)' }, { filter: 'brightness(1)' }], { duration: 240 });
      await wait(260);
    }

    function hideCursor() {
      cursor.style.opacity = '0';
    }

    function mainState(state: string, status: string) {
      main.dataset.mainState = state;
      main.querySelector('[data-status]')!.textContent = status;
    }

    /** Back to the first frame: every row in its first place, the conversation at its second step. */
    function reset() {
      for (const item of start) {
        const el = row(item.id);
        el.dataset.state = item.state;
        el.querySelector('[data-sub]')!.textContent = item.sub;
        el.querySelector('[data-age]')!.textContent = item.age;
        group(item.group).append(el);
      }
      main.querySelectorAll('[data-step], [data-perm], [data-allowed], [data-catchup]').forEach((el) => el.classList.remove('on'));
      main.querySelector('[data-step="1"]')!.classList.add('on');
      main.querySelector('[data-thinking]')!.classList.add('on');
      root.querySelector('[data-commit]')!.textContent = 'Commit';
      toast.classList.remove('on');
      mainState('working', 'Claude is working');
      cursor.style.transition = 'none';
      cursor.style.opacity = '0';
      cursor.style.transform = `translate(${win.clientWidth * 0.62}px, ${win.clientHeight + 30}px)`;
      cursor.getBoundingClientRect();
      cursor.style.transition = '';
      tally();
    }

    const show = (selector: string, on = true) => main.querySelector(selector)!.classList.toggle('on', on);

    /** The story, once round. */
    async function loop() {
      await wait(1300);
      main.querySelectorAll('[data-step="2"]').forEach((el) => el.classList.add('on'));
      pulse('working');
      await wait(1500);

      // Claude asks: the session jumps to Needs you, the permission card and a notification show.
      show('[data-thinking]', false);
      show('[data-perm]');
      mainState('needs', 'Waiting for you');
      set('stripe', 'needs', 'needs', 'Permission: Bash');
      toast.classList.add('on');
      pulse('needs');
      pulse('needs');
      await wait(1700);

      await click(root.querySelector<HTMLElement>('[data-allow]')!);
      toast.classList.remove('on');
      show('[data-perm]', false);
      show('[data-allowed]');
      show('[data-thinking]');
      mainState('working', 'Claude is working');
      set('stripe', 'working', 'working', 'chore/stripe-18 · payments-api', 'now', true);
      pulse('working');
      hideCursor();
      await wait(1300);

      // Another session finishes while you look elsewhere: blue, unread, with how long it takes to review.
      set('dark', 'unread', 'today', 'acme-store · ~2 min to review', 'now', true);
      pulse('unread');
      await wait(1000);

      // Its project is free now, so the queued prompt is ready. Start it.
      set('search', 'ready', undefined, 'Ready · acme-store is free');
      pulse('ok');
      await wait(1200);
      await click(row('search').querySelector<HTMLElement>('[data-start]')!);
      set('search', 'working', 'working', 'feat/product-search · acme-store', 'now');
      pulse('working');
      hideCursor();
      await wait(1300);

      show('[data-step="3"]');
      await wait(1300);

      // The open session finishes: its catch-up says what happened and what it needs.
      show('[data-thinking]', false);
      mainState('finished', 'Finished');
      set('stripe', 'open', 'today', 'payments-api · ~2 min to review', 'now', true);
      show('[data-catchup]');
      pulse('unread');
      await wait(2000);
      await click(root.querySelector<HTMLElement>('[data-commit]')!);
      root.querySelector('[data-commit]')!.textContent = 'Committed';
      pulse('ok');
      hideCursor();
      await wait(2600);

      await win.animate([{ opacity: 1 }, { opacity: 0.0 }], { duration: 450, fill: 'forwards' }).finished;
      reset();
      await win.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 450, fill: 'forwards' }).finished;
    }

    /** Reduced motion: one still frame, the moment Claude asks. */
    function still() {
      reset();
      main.querySelectorAll('[data-step="2"]').forEach((el) => el.classList.add('on'));
      show('[data-thinking]', false);
      show('[data-perm]');
      mainState('needs', 'Waiting for you');
      const el = row('stripe');
      el.dataset.state = 'needs';
      el.querySelector('[data-sub]')!.textContent = 'Permission: Bash';
      group('needs').append(el);
      row('dark').dataset.state = 'unread';
      row('dark').querySelector('[data-sub]')!.textContent = 'acme-store · ~2 min to review';
      group('today').prepend(row('dark'));
      row('search').dataset.state = 'ready';
      row('search').querySelector('[data-sub]')!.textContent = 'Ready · acme-store is free';
      toast.classList.add('on');
      tally();
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduced.matches) {
      still();
      return;
    }
    reset();
    root.classList.add('is-live');
    new IntersectionObserver(([entry]) => {
      visible = !!entry?.isIntersecting;
      if (visible && !running) {
        running = true;
        (async () => {
          for (;;) await loop();
        })();
      }
    }, { threshold: 0.2 }).observe(root);
    // A slow, steady trickle of yellow: sessions working somewhere.
    setInterval(() => visible && !document.hidden && pulse('working'), 2600);
  }

  document.querySelectorAll<HTMLElement>('[data-live-board]').forEach(board);
</script>

<style>
  .lb {
    position: relative;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 1.5rem 0 0;
    text-align: start;
    font-family: var(--sb-font-sans);
    --needs: var(--sb-warn);
    --working: var(--sb-accent-ink);
    --unread: var(--sb-unread);
    --ok: var(--sb-ok);
  }

