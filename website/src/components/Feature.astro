---
/** One feature on the homepage: a heading, a short text and a link to its docs, next to a screenshot. */
import Screenshot from './Screenshot.astro';

interface Props {
  title: string;
  shot: string;
  alt: string;
  /** A docs page, without the base: `/sessions/sidebar/`. */
  href: string;
  linkText?: string;
  /** Screenshot on the left. */
  flip?: boolean;
  /** At most this wide, in px: for a tall crop such as the sidebar. */
  shotWidth?: number;
}
const { title, shot, alt, href, linkText = 'Read more', flip = false, shotWidth } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class:list={['sb-feature', 'not-content', { flip }]}>
  <div class="sb-feature-copy">
    <h2>{title}</h2>
    <div class="sb-feature-text"><slot /></div>
    <a class="sb-feature-link" href={`${base}${href}`}>{linkText} →</a>
  </div>
  <div class="sb-feature-shot">
    <Screenshot name={shot} alt={alt} width={shotWidth} />
  </div>
</section>

<style>
  .sb-feature {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding-block: 3rem;
    border-top: 1px solid var(--sb-border);
  }
  @media (min-width: 60rem) {
    .sb-feature {
      grid-template-columns: 5fr 8fr;
      gap: 3rem;
    }
    .sb-feature.flip .sb-feature-copy {
      order: 2;
    }
  }
  h2 {
    margin: 0;
    font-size: var(--sb-text-hero);
    font-weight: 600;
    line-height: 1.3;
    color: var(--sb-text);
  }
  .sb-feature-text {
    margin-top: 0.75rem;
    font-size: var(--sb-text-body);
    line-height: 1.6;
    color: var(--sb-muted);
  }
  .sb-feature-text :global(p) {
    margin: 0 0 0.75rem;
  }
  .sb-feature-text :global(strong) {
    color: var(--sb-text);
    font-weight: 600;
  }
  .sb-feature-link {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: var(--sb-text-ui);
    font-weight: 600;
    color: var(--sb-accent-ink);
    text-decoration: none;
  }
  .sb-feature-link:hover {
    text-decoration: underline;
  }
  .sb-feature-shot :global(.sb-shot) {
    margin: 0 auto;
  }
</style>
