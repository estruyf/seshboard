+/** Rename… on a favourite's tile: the name the tile and its tooltip show. Empty gives the address back. */
+export function RenameFavoriteDialog({ favorite, onClose }: { favorite: BrowserFavorite; onClose(): void }) {
+  const [value, setValue] = useState(favorite.title);
+  const inputRef = useRef<HTMLInputElement>(null);
+  const id = useId();
+  useEffect(() => inputRef.current?.select(), []);
+  const save = () => {
+    renameFavorite(favorite.id, value);
+    onClose();
+  };
+  return (
+    <Dialog
+      width="sm"
+      title="Rename favourite"
+      onClose={onClose}
+      onSubmit={save}
+      initialFocus={inputRef}
+      data-rename-favorite-dialog
+      footer={
+        <>
+          <Button onClick={onClose}>Cancel</Button>
+          <Button variant="primary" kbd="↵" data-rename-favorite-save onClick={save}>
+            Rename
+          </Button>
+        </>
+      }
+    >
+      <form
+        onSubmit={(e) => {
+          e.preventDefault();
+          save();
+        }}
+      >
+        <label htmlFor={`${id}-name`} className="sr-only">
+          Favourite name
+        </label>
+        <input
+          ref={inputRef}
+          id={`${id}-name`}
+          value={value}
+          maxLength={500}
+          onChange={(e) => setValue(e.target.value)}
+          placeholder={favorite.url}
+          className="h-7 w-full rounded-md border border-edge bg-bg px-2.5 text-ui text-text outline-none focus:border-accent-ink"
+          data-rename-favorite-input
+        />
+      </form>
+    </Dialog>
+  );
+}
