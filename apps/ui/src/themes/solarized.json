{
  "$schema": "https://raw.githubusercontent.com/estruyf/switchboard/main/docs/switchboard-theme.schema.json",
  "name": "Solarized",
  "author": "Ethan Schoonover (ported by Elio Struyf)",
  "version": 1,

  "light": {
    "canvas": "#fdf6e3",
    "accent": "#b58900",
    "colors": {
      "bg": "#fdf6e3",
      "sidebar": "#eee8d5",
      "card": "#fffbee",
      "popover": "#fffbee",
      "border": "#e4dcc4",
      "overlay-border": "#d6ccb0",
      "overlay-shadow": "rgb(7 54 66 / 0.18)",
      "text": "#073642",
      "muted": "#586e75",
      "faint": "#657b83",
      "link": "#268bd2",
      "selected": "rgb(7 54 66 / 0.08)",
      "scrim": "rgb(0 43 54 / 0.35)",
      "ok": "#859900",
      "warn": "#d33682",
      "error": "#dc322f",
      "caution": "#cb4b16",
      "unread": "#268bd2",
      "accent": "#b58900",
      "accent-ink": "#8a6900",
      "on-accent": "#fdf6e3",
      "code-bg": "#f5eedb",
      "diff-added": "rgb(133 153 0 / 0.14)",
      "diff-removed": "rgb(220 50 47 / 0.14)",
      "terminal-bg": "#002b36",
      "terminal-shadow": "rgb(7 54 66 / 0.16)",
      "profile-yellow": "#b58900",
      "profile-blue": "#268bd2",
      "profile-green": "#859900",
      "profile-purple": "#6c71c4",
      "profile-red": "#dc322f",
      "profile-orange": "#cb4b16",
      "profile-gray": "#93a1a1",
      "working-plug-a": "#d33682",
      "working-plug-b": "#dc322f",
      "working-plug-c": "#2aa198",
      "working-plug-d": "#268bd2"
    },
    "syntax": "solarized-light"
  },

  "dark": {
    "canvas": "#002b36",
    "accent": "#b58900",
    "colors": {
      "bg": "#002b36",
      "sidebar": "#073642",
      "card": "#073642",
      "popover": "#0b3d4a",
      "border": "#0e4552",
      "overlay-border": "#1a5361",
      "overlay-shadow": "rgb(0 0 0 / 0.6)",
      "text": "#eee8d5",
      "muted": "#93a1a1",
      "faint": "#839496",
      "link": "#268bd2",
      "selected": "rgb(238 232 213 / 0.10)",
      "scrim": "rgb(0 0 0 / 0.6)",
      "ok": "#859900",
      "warn": "#d33682",
      "error": "#dc322f",
      "caution": "#cb4b16",
      "unread": "#268bd2",
      "accent": "#b58900",
      "accent-ink": "#d4a417",
      "on-accent": "#002b36",
      "code-bg": "#01313d",
      "diff-added": "rgb(133 153 0 / 0.16)",
      "diff-removed": "rgb(220 50 47 / 0.16)",
      "terminal-bg": "#001f27",
      "terminal-shadow": "rgb(0 0 0 / 0.55)",
      "profile-yellow": "#b58900",
      "profile-blue": "#268bd2",
      "profile-green": "#859900",
      "profile-purple": "#6c71c4",
      "profile-red": "#dc322f",
      "profile-orange": "#cb4b16",
      "profile-gray": "#93a1a1",
      "working-plug-a": "#d33682",
      "working-plug-b": "#dc322f",
      "working-plug-c": "#2aa198",
      "working-plug-d": "#268bd2"
    },
    "terminal": {
      "background": "#001f27",
      "foreground": "#93a1a1",
      "cursor": "#b58900",
      "selection": "rgb(147 161 161 / 0.25)",
      "ansi": [
        "#073642", "#dc322f", "#859900", "#b58900", "#268bd2", "#d33682", "#2aa198", "#eee8d5",
        "#002b36", "#cb4b16", "#586e75", "#657b83", "#839496", "#6c71c4", "#93a1a1", "#fdf6e3"
      ]
    },
    "syntax": "solarized-dark"
  }
}
