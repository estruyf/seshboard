{
  "$schema": "https://raw.githubusercontent.com/estruyf/switchboard/main/docs/switchboard-theme.schema.json",
  "$comment": "Catppuccin (catppuccin.com): Latte in light mode, Mocha in dark, with the Mauve accent, mapped as catppuccin/vscode does. Latte's green, pink, peach, yellow and blue are a little darker here so they read as text on its base. Text is a step darker than Latte's (and brighter than Mocha's) so messages and the message box keep enough contrast; muted takes Latte's Text and Mocha's Subtext1. Code colours are Shiki's catppuccin-latte and catppuccin-mocha.",
  "name": "Catppuccin",
  "author": "Catppuccin (ported by Elio Struyf)",
  "version": 1,

  "light": {
    "canvas": "#eff1f5",
    "accent": "#8839ef",
    "colors": {
      "bg": "#eff1f5",
      "sidebar": "#e6e9ef",
      "card": "#e6e9ef",
      "popover": "#eff1f5",
      "code-bg": "#e6e9ef",
      "border": "#ccd0da",
      "overlay-border": "#bcc0cc",
      "overlay-shadow": "#4c4f6933",
      "text": "#2f3245",
      "muted": "#4c4f69",
      "faint": "#7c7f93",
      "link": "#1a5fe0",
      "selected": "#ccd0da",
      "focus-ring": "#8839ef8c",
      "scrim": "#4c4f6959",
      "ok": "#2b7a1f",
      "warn": "#b03d92",
      "error": "#d20f39",
      "caution": "#b44c08",
      "unread": "#1a5fe0",
      "accent": "#8839ef",
      "accent-ink": "#8839ef",
      "on-accent": "#eff1f5",
      "diff-added": "#40a02b33",
      "diff-removed": "#d20f3933",
      "terminal-bg": "#11111b",
      "terminal-shadow": "#4c4f6929",
      "profile-yellow": "#a8650e",
      "profile-blue": "#1e66f5",
      "profile-green": "#2b7a1f",
      "profile-purple": "#8839ef",
      "profile-red": "#d20f39",
      "profile-orange": "#c24a06",
      "profile-gray": "#7c7f93",
      "working-plug-a": "#ea76cb",
      "working-plug-b": "#e64553",
      "working-plug-c": "#209fb5",
      "working-plug-d": "#1e66f5"
    },
    "syntax": "catppuccin-latte"
  },

  "dark": {
    "canvas": "#1e1e2e",
    "accent": "#cba6f7",
    "colors": {
      "bg": "#1e1e2e",
      "sidebar": "#181825",
      "card": "#181825",
      "popover": "#1e1e2e",
      "code-bg": "#181825",
      "border": "#313244",
      "overlay-border": "#45475a",
      "overlay-shadow": "#000000b3",
      "text": "#e2e7fa",
      "muted": "#bac2de",
      "faint": "#7f849c",
      "link": "#89b4fa",
      "selected": "#313244",
      "focus-ring": "#cba6f78c",
      "scrim": "#00000099",
      "ok": "#a6e3a1",
      "warn": "#f5c2e7",
      "error": "#f38ba8",
      "caution": "#fab387",
      "unread": "#89b4fa",
      "accent": "#cba6f7",
      "accent-ink": "#cba6f7",
      "on-accent": "#11111b",
      "diff-added": "#a6e3a133",
      "diff-removed": "#f38ba833",
      "terminal-bg": "#11111b",
      "terminal-shadow": "#0000008c",
      "profile-yellow": "#f9e2af",
      "profile-blue": "#89b4fa",
      "profile-green": "#a6e3a1",
      "profile-purple": "#cba6f7",
      "profile-red": "#f38ba8",
      "profile-orange": "#fab387",
      "profile-gray": "#9399b2",
      "working-plug-a": "#f5c2e7",
      "working-plug-b": "#eba0ac",
      "working-plug-c": "#74c7ec",
      "working-plug-d": "#89b4fa"
    },
    "terminal": {
      "background": "#11111b",
      "foreground": "#cdd6f4",
      "cursor": "#f5e0dc",
      "selection": "#585b70",
      "ansi": [
        "#45475a", "#f38ba8", "#a6e3a1", "#f9e2af", "#89b4fa", "#f5c2e7", "#94e2d5", "#a6adc8",
        "#585b70", "#f37799", "#89d88b", "#ebd391", "#74a8fc", "#f2aede", "#6bd7ca", "#bac2de"
      ]
    },
    "syntax": "catppuccin-mocha"
  }
}
