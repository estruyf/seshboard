{
  "$schema": "https://raw.githubusercontent.com/estruyf/seshboard/main/docs/switchboard-theme.schema.json",
  "$comment": [
    "Greys only, for a quiet window. Errors and what needs you keep red and amber; links are underlined, not coloured.",
    "Code and diffs keep their colours (Demo Time's code colours, green and red diff lines): Settings › Theme › Code highlighting turns them off, in any theme.",
    "monochrome: project, editor and site icons show in greys too."
  ],
  "name": "Black and white",
  "author": "Elio Struyf",
  "version": 1,
  "monochrome": true,
  "light": {
    "canvas": "#ffffff",
    "accent": "#171717",
    "colors": {
      "bg": "#ffffff",
      "sidebar": "#f5f5f5",
      "card": "#ffffff",
      "popover": "#ffffff",
      "code-bg": "#f5f5f5",
      "code-pane": "#ffffff",
      "border": "#d4d4d4",
      "overlay-border": "#c8c8c8",
      "field-border": "#8a8a8a",
      "overlay-shadow": "#00000033",
      "text": "#171717",
      "paper": "#ffffff",
      "paper-text": "#171717",
      "muted": "#525252",
      "faint": "#666666",
      "link": "#171717",
      "selected": "#e8e8e8",
      "focus-ring": "#1717178c",
      "scrim": "#00000059",
      "ok": "#525252",
      "warn": "#a15c00",
      "error": "#c92a2a",
      "caution": "#a15c00",
      "unread": "#171717",
      "memory": "#525252",
      "remote": "#525252",
      "trigger": "#525252",
      "pipeline": "#525252",
      "ultrathink-a": "#171717",
      "ultrathink-b": "#404040",
      "ultrathink-c": "#525252",
      "ultrathink-d": "#737373",
      "accent": "#171717",
      "accent-ink": "#171717",
      "on-accent": "#ffffff",
      "diff-added": "#1a7f3724",
      "diff-removed": "#cf222e24",
      "terminal-bg": "#111111",
      "terminal-shadow": "#00000029",
      "profile-yellow": "#171717",
      "profile-blue": "#404040",
      "profile-green": "#525252",
      "profile-purple": "#737373",
      "profile-red": "#8a8a8a",
      "profile-orange": "#a3a3a3",
      "profile-gray": "#bdbdbd",
      "chart-output": "#171717",
      "chart-cache-write": "#525252",
      "chart-cache-read": "#8a8a8a",
      "chart-input": "#bdbdbd",
      "chart-time": "#404040",
      "chart-turns": "#8a8a8a",
      "chart-shipped": "#171717",
