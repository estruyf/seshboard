      "working-plug-a": "#525252",
      "working-plug-b": "#171717",
      "working-plug-c": "#737373",
      "working-plug-d": "#404040"
    }
  },
  "dark": {
    "canvas": "#111111",
    "accent": "#ededed",
    "colors": {
      "bg": "#111111",
      "sidebar": "#161616",
      "card": "#1c1c1c",
      "popover": "#1c1c1c",
      "code-bg": "#1c1c1c",
      "code-pane": "#111111",
      "border": "#ffffff1a",
      "overlay-border": "#ffffff29",
      "field-border": "#6b6b6b",
      "overlay-shadow": "#000000b3",
      "text": "#ededed",
      "paper": "#111111",
      "paper-text": "#ededed",
      "muted": "#b0b0b0",
      "faint": "#8f8f8f",
      "link": "#ededed",
      "selected": "#262626",
      "focus-ring": "#ededed8c",
      "scrim": "#00000099",
      "ok": "#b0b0b0",
      "warn": "#f2d26b",
