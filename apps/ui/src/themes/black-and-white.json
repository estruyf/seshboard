      "chart-input": "#595959",
      "chart-time": "#cccccc",
      "chart-turns": "#808080",
      "chart-shipped": "#ededed",
      "working-hole": "#333333",
      "working-lit": "#f2f2f2",
      "working-glow": "#b0b0b0",
      "working-plug-a": "#8c8c8c",
      "working-plug-b": "#d9d9d9",
      "working-plug-c": "#808080",
      "working-plug-d": "#bfbfbf"
    },
    "terminal": {
      "background": "#0a0a0a",
      "foreground": "#ededed",
      "cursor": "#ededed",
      "selection": "#ededed40",
      "ansi": [
        "#1f1f1f",
        "#ff8787",
        "#bfbfbf",
        "#f2d26b",
        "#a3a3a3",
        "#b3b3b3",
        "#cccccc",
        "#ededed",
        "#5c5c5c",
        "#ffa8a8",
        "#d9d9d9",
        "#f5e09a",
        "#bfbfbf",
        "#cccccc",
        "#e0e0e0",
        "#ffffff"
      ]
    }
  }
}
