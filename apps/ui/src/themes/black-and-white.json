      "ultrathink-c": "#bfbfbf",
      "ultrathink-d": "#b0b0b0",
      "accent": "#ededed",
      "accent-ink": "#ededed",
      "on-accent": "#111111",
      "diff-added": "#51cf6624",
      "diff-removed": "#ff6b6b24",
      "terminal-bg": "#0a0a0a",
      "terminal-shadow": "#0000008c",
      "profile-yellow": "#ffffff",
      "profile-blue": "#d9d9d9",
      "profile-green": "#bfbfbf",
      "profile-purple": "#a3a3a3",
