{
  "name": "@switchboard/desktop",
  "productName": "Switchboard",
  "version": "0.0.13",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && node scripts/smoke.ts",
    "screenshots": "electron-vite build && node scripts/screenshots.ts",
    "typecheck": "tsc -p tsconfig.json",
    "icon": "node scripts/icon/build.mjs",
    "dist": "electron-vite build && node scripts/dist.mjs --publish never",
    "dist:preview": "electron-vite build && node scripts/dist.mjs --config electron-builder.preview.yml --publish never",
    "mock-updates": "node scripts/mock-update-server.ts",
    "smoke:packaged": "node scripts/smoke.ts --packaged",
    "dist:notarized": "APPLE_KEYCHAIN_PROFILE=switchboard-notary npm run dist"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@switchboard/engine": "*",
    "@switchboard/protocol": "*",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0"
  },
  "description": "A fast desktop app for managing Claude Code sessions",
  "author": "Elio Struyf"
}
