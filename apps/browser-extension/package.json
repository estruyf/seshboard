{
  "private": true,
  "name": "@seshboard/browser-extension",
  "description": "Send what you select on a page to a Seshboard session, or start one in the page's project.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Elio Struyf",
    "url": "https://www.eliostruyf.com"
  },
  "scripts": {
    "dev": "node scripts/dev-host.mjs chrome && extension dev --browser chrome",
    "dev:firefox": "extension dev --browser zen",
    "build": "extension build --browser chrome && extension build --browser firefox",
    "build:chrome": "extension build --browser chrome",
    "build:firefox": "extension build --browser firefox",
    "typecheck": "tsc -p tsconfig.json",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@seshboard/protocol": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "extension": "^4.0.22",
    "tailwindcss": "^4.3.3"
  }
}
