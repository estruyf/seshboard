{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "version": "0.1.0",
  "name": "Seshboard",
  "description": "Send what you select on a page to a Seshboard session, or start one in the page's project.",
  "author": "Elio Struyf",
  "homepage_url": "https://seshboard.app/",
  "chromium:key": "",
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "seshboard@eliostruyf.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Seshboard",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": [
      "background.ts"
    ]
  },
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "content/console-main.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "content/console-bridge.ts"
      ],
      "run_at": "document_start"
    }
  ]
}
