{
  "name": "switchboard-companion",
  "displayName": "Seshboard Companion",
  "description": "Send the open file, selected lines, problems and terminal output from VS Code to a Seshboard session.",
  "version": "0.3.0",
  "license": "MIT",
  "publisher": "eliostruyf",
  "author": "Elio Struyf",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/estruyf/switchboard",
    "directory": "apps/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/estruyf/switchboard/issues"
  },
  "homepage": "https://github.com/estruyf/switchboard/blob/main/docs/vscode-companion.md",
  "type": "module",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "seshboard",
    "switchboard",
    "context",
    "ai"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": [
        "seshboard.appDataFolder"
      ]
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "seshboard.addSelection",
        "title": "Add Selection to Seshboard",
        "category": "Seshboard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "seshboard.addFile",
        "title": "Add to Seshboard",
        "category": "Seshboard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "seshboard.addOpenEditors",
        "title": "Add Open Editors to Seshboard",
        "category": "Seshboard"
      },
      {
        "command": "seshboard.addEditorGroup",
        "title": "Add Editors in This Group to Seshboard",
        "category": "Seshboard"
      },
      {
        "command": "seshboard.addProblems",
        "title": "Add Problems in This File to Seshboard",
        "category": "Seshboard"
      },
      {
        "command": "seshboard.fixProblems",
        "title": "Fix in Seshboard",
        "category": "Seshboard"
      },
      {
        "command": "seshboard.addWorkspaceProblems",
        "title": "Add Problems in the Workspace to Seshboard",
        "category": "Seshboard"
      },
      {
        "command": "seshboard.addTerminalSelection",
        "title": "Add Terminal Selection to Seshboard",
        "category": "Seshboard"
      },
      {
        "command": "seshboard.addChanges",
        "title": "Add Changes to Seshboard",
        "category": "Seshboard"
      },
      {
        "command": "seshboard.answerPrompts",
        "title": "Answer Prompts",
        "category": "Seshboard"
      },
      {
        "command": "seshboard.showSessions",
        "title": "Show Sessions",
        "category": "Seshboard"
      },
      {
        "command": "seshboard.reconnect",
        "title": "Reconnect",
        "category": "Seshboard"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "seshboard.addSelection",
          "group": "seshboard@1",
          "when": "resourceScheme == file || resourceScheme == untitled"
        },
        {
          "command": "seshboard.addProblems",
          "group": "seshboard@2",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title": [
        {
          "command": "seshboard.addSelection",
          "group": "navigation@100",
          "when": "resourceScheme == file && config.seshboard.editorTitleButton"
        }
      ],
      "editor/title/context": [
        {
          "command": "seshboard.addFile",
          "group": "seshboard@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "seshboard.addEditorGroup",
          "group": "seshboard@2"
        }
      ],
      "explorer/context": [
        {
          "command": "seshboard.addFile",
          "group": "seshboard@1",
          "when": "resourceScheme == file"
        }
      ],
      "terminal/context": [
        {
          "command": "seshboard.addTerminalSelection",
          "group": "seshboard@1"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "seshboard.addChanges",
          "group": "seshboard@1",
          "when": "scmProvider == git"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "seshboard.addChanges",
          "group": "seshboard@1",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "seshboard.addFile",
          "when": "resourceScheme == file"
        },
        {
          "command": "seshboard.fixProblems",
          "when": "resourceScheme == file"
        }
      ]
    },
    "keybindings": [
      {
        "command": "seshboard.addSelection",
        "key": "alt+shift+k",
        "when": "editorTextFocus"
      },
      {
        "command": "seshboard.addTerminalSelection",
        "key": "alt+shift+k",
        "when": "terminalFocus && terminalTextSelected"
      }
    ],
    "configuration": {
      "title": "Seshboard",
      "properties": {
        "seshboard.bringToFront": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Bring Seshboard to the front on the session when you add something to it. Turn off to add context quietly; it waits in the session's message box."
        },
        "seshboard.statusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what needs you in Seshboard (for this workspace) in the status bar."
        },
        "seshboard.prompts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show permission prompts, questions and plans from this workspace's sessions as notifications, and answer them in VS Code. Dismissing one leaves it waiting in Seshboard; **Seshboard: Answer Prompts** shows it again."
        },
        "seshboard.quickFix": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer **Fix in Seshboard** in the quick fixes of an error or warning: it adds the problem and its lines to a session."
        },
        "seshboard.editorTitleButton": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show a button in the editor title bar that adds the selection (or the file) to Seshboard."
        },
        "seshboard.appDataFolder": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Where Seshboard keeps its data, when it isn't in the usual place (a build started with `SESHBOARD_DATA_DIR`). Leave empty to find the installed app, then a development build."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/build.ts --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "node scripts/build.ts --production && npx --yes @vscode/vsce@4 package --no-dependencies"
  },
  "devDependencies": {
    "@seshboard/protocol": "*",
    "@types/vscode": "~1.95.0",
    "esbuild": "^0.28.2"
  }
}
